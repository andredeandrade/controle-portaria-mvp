# Ambiente dos testes da API (Vitest + Supertest).
# Copie para api/.env.test (não versionado). O setup aborta se DATABASE_URL
# não apontar para um host local ou se o nome do banco não terminar em "_test".
# O banco é criado e migrado automaticamente na primeira execução.
NODE_ENV=test
DATABASE_URL=postgresql://controle:SENHA@localhost:5432/controleportaria_test?schema=public
JWT_SECRET=jwt-secret-ficticio-somente-para-testes
JWT_EXPIRES_IN=1h
DATA_ENCRYPTION_KEY=chave-de-criptografia-ficticia-somente-para-testes
PLATFORM_SETUP_SECRET=platform-secret-ficticio-somente-para-testes
CORS_ORIGIN=http://localhost:3000
