NODE_ENV=
WEB_PORT=
API_PORT=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=
DATA_ENCRYPTION_KEY=
PLATFORM_SETUP_SECRET=
CORS_ORIGIN=

# Segurança da API (opcionais)
# TRUST_PROXY=1            # nº de proxies confiáveis à frente da API (para req.ip correto)
# BODY_LIMIT=100kb
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=600
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20

# Tenant do web (opcionais)
# APP_ROOT_DOMAIN=portaria.com.br   # só hosts <slug>.<domínio> têm tenant; o domínio raiz não. Em hospedagem sem subdomínio por tenant (ex.: demo em app.vercel.app), use o próprio host do app.
# DEFAULT_TENANT_SLUG=demo          # tenant usado quando o host não traz subdomínio

# Demo pública
# DEMO_MODE=true                # (api) "true", "false" ou vazio (outro valor impede a API de subir). Desabilita o setup de plataforma (criar condomínios e bootstrap de usuários com PLATFORM_SETUP_SECRET) e a troca do slug do condomínio
# NEXT_PUBLIC_DEMO_MODE=true   # (web) mostra banner de demonstração e login rápido por perfil; é embutida no build
